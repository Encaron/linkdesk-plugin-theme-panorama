{
  "$schema": "./node_modules/@linkdesk/plugin-sdk/schemas/plugin.schema.json",
  "pluginId": "theme-panorama",
  "name": "整窗主视觉",
  "version": "1.1.0",
  "category": "themes",
  "categories": [
    "color-scheme"
  ],
  "description": "极限壳主题——background 域极限：sailor-moon.jpg 全窗低遮罩当主视觉，chrome 半透明让位（#50.27 效果验收端到端裁决，gallery ⑪ 壳真实落地）",
  "author": "Encaron",
  "icon": "resources/icon.svg",
  "contributes": {
    "themes": [
      {
        "id": "theme-panorama.panorama",
        "label": "整窗主视觉",
        "uiTheme": "dark",
        "path": "themes/panorama.json"
      }
    ],
    "i18n": {
      "en": "i18n/en.json"
    }
  },
  "readme": {
    "default": "README.md",
    "locales": {
      "zh": "README.md",
      "en": "docs/readme/en.md"
    }
  }
}
